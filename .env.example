# Database Configuration
# DATABASE_URL is used by both backend (SQLAlchemy) and frontend (Prisma/Auth.js)
DATABASE_URL=postgresql://postgres:password@localhost:5432/notuma?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=notuma

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# S3/Cloudflare R2 Storage Configuration
# Note: Code uses these names, while docker-compose.yml uses shorter ones.
S3_ENDPOINT_URL=https://your-endpoint.com
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_REGION_NAME=auto
S3_BUCKET_NAME=notuma-assets
S3_PUBLIC_URL=https://pub-your-id.r2.dev

# S3 variables used in docker-compose.yml (for consistency)
S3_ENDPOINT=https://your-endpoint.com
S3_ACCESS_KEY=your-access-key-id
S3_SECRET_KEY=your-secret-access-key
S3_BUCKET=notuma-assets

# Authentication (Auth.js / NextAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# Monitoring (Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
ENVIRONMENT=development

# AI Provider API Keys
# Pollinations is used by default and doesn't require a key.
OPENAI_API_KEY=
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
NANOBANANA_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
